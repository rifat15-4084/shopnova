# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public base URL of THIS api (no trailing slash)
API_URL=http://localhost:5000
# Comma separated list of allowed client origins
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/shopnova

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false

# ── Stripe (test mode) ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# ── Cloudinary (optional – falls back to local /uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail (optional – console stub by default) ─────────────────────────────────
MAIL_FROM="ShopNova <no-reply@shopnova.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Commerce rules ────────────────────────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=100
FLAT_SHIPPING_RATE=7.5
TAX_RATE=0.05
DEFAULT_CURRENCY=usd

# ── Logging / misc ────────────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
