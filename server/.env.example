# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public base URL of THIS api (no trailing slash)
API_URL=http://localhost:5000
# Comma separated list of allowed client origins.
# Supports wildcards for preview deployments, e.g. production + previews:
# CLIENT_URL=http://localhost:5173,https://shop-nava.vercel.app,https://*.vercel.app
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas (placeholder — the real connection string lives ONLY in your
# untracked server/.env and must never be committed anywhere):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/shopnova?retryWrites=true&w=majority
# Local-only alternative: MONGODB_URI=mongodb://127.0.0.1:27017/shopnova
# Production seeding (npm run seed:prod) reads MONGODB_URI directly and refuses
# to run unless you confirm per-invocation:  SEED_CONFIRM=yes npm run seed:prod

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# Dev only — in NODE_ENV=production cookies are always Secure + SameSite=None
COOKIE_SECURE=false

# ── Stripe (test mode) ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# ── Cloudinary (REQUIRED in production – local /uploads is dev-only) ──────────
# Production uploads fail with STORAGE_NOT_CONFIGURED until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail (optional – console stub by default) ─────────────────────────────────
MAIL_FROM="ShopNova <no-reply@shopnova.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Commerce rules ────────────────────────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=100
FLAT_SHIPPING_RATE=7.5
TAX_RATE=0.05
DEFAULT_CURRENCY=usd

# ── Logging / misc ────────────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
