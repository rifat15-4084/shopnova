# Base URL of the ShopNova API (no trailing slash) — inlined at BUILD time.
#   Dev: leave unset — the client falls back to the local API (http://localhost:5000).
#   Production: set it BEFORE building, e.g.
#       VITE_API_URL=https://shopnova-api.onrender.com
#     and REDPLOY after changing it — an already-built bundle keeps the old value.
#   Leave unset ONLY when the API is served from the same origin as the client
#   (the Vercel /api rewrite to the serverless function in this repo).
# VITE_API_URL=

# Shown in the checkout banner so testers know which card to use.
VITE_STRIPE_TEST_CARD=4242 4242 4242 4242
