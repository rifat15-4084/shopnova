# Base URL of the ShopNova API (no trailing slash).
# In dev, Vite proxies /api to this URL's host via vite.config.ts; in production
# set it to your deployed API, e.g. https://shopnova-api.onrender.com
VITE_API_URL=http://localhost:5000

# Shown in the checkout banner so testers know which card to use.
VITE_STRIPE_TEST_CARD=4242 4242 4242 4242
